<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base theme - lightweight, used until Compose takes over -->
    <style name="Theme.PrepVault" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Splash theme (used as launcher theme): brand gradient background -->
    <style name="Theme.PrepVault.Splash" parent="Theme.PrepVault">
        <item name="android:windowBackground">@drawable/ic_launcher_background</item>
    </style>
</resources>
